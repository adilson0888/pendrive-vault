"""Pendrive Vault — a minimal GTK4 front-end for LUKS2 volumes marked with a
LUKS2 label, unlocked either with a FIDO2 security key or with a passphrase,
then browsed with the desktop's file manager.

Volumes are discovered at runtime (the helper is authoritative); no UUID is
baked into this file. No cryptography is implemented here: the FIDO2 path
delegates to the official systemd token handler shipped with cryptsetup.
"""
from __future__ import annotations

import os
import re
import subprocess
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk  # noqa: E402

APP_ID = "org.pendrivevault.PendriveVault"
HELPER = "/usr/local/libexec/pendrive-vault-helper"
LOG = "/run/pendrive-vault/last.log"
USER = os.environ.get("USER") or "user"

TOUCH_RE = re.compile(r"(touch|confirm presence|presence on security)", re.I)
FIELD_RE = re.compile(r'(\w+)="([^"]*)"')

ERRORS = {
    "device-not-found": "The pendrive is not plugged in.",
    "already-unlocked": "The volume is already unlocked.",
    "fido2-failed": "The security key did not unlock the volume.\n\n"
                    "Check the PIN, and touch the key promptly when it blinks\n"
                    "(the key stops waiting after about 30 seconds).",
    "passphrase-failed": "Wrong passphrase.",
    "mount-failed": "Unlocked, but mounting the filesystem failed.",
    "umount-failed": "Could not unmount — a file may still be open in another app.",
    "close-failed": "Could not lock the volume.",
    "open-failed": "The volume could not be opened.",
    "not-a-vault": "That device is not a Pendrive Vault volume\n"
                   "(wrong LUKS2 label, not USB, or not the configured volume).",
    "bad-uuid": "Invalid volume identifier.",
    "not-root": "The helper was not started with privileges.",
    "no-caller": "Could not determine the calling user.",
    "bad-action": "Internal error: bad action.",
    "not-configured": "Pendrive Vault is not installed correctly\n"
                      "(missing /etc/pendrive-vault.conf).",
    "bad-config-marker": "The MARKER in /etc/pendrive-vault.conf is not valid.",
    "bad-config-uuid": "The UUID in /etc/pendrive-vault.conf is not valid.",
    "mount-target-symlink": "Refusing to mount over a symlink.",
}


# --------------------------------------------------------------- discovery --
def field(line: str, key: str) -> str:
    for name, value in FIELD_RE.findall(line):
        if name == key:
            return value
    return ""


def usb_luks_devices() -> list[str]:
    """Cheap, unprivileged probe used to notice plug/unplug events.

    The authoritative list comes from the helper (labels need root), this only
    tells us when to ask again.
    """
    try:
        out = subprocess.run(["lsblk", "-Pno", "NAME,TYPE,FSTYPE,TRAN"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    found: list[str] = []
    on_usb = False
    for line in out.splitlines():
        kind = field(line, "TYPE")
        if kind == "disk":
            on_usb = field(line, "TRAN") == "usb"
        elif kind == "part" and field(line, "FSTYPE") == "crypto_LUKS" and on_usb:
            found.append("/dev/" + field(line, "NAME"))
    return found


def volume_title(dev: str) -> str:
    try:
        real = os.path.realpath(dev)
        disk = real.replace("/dev/", "")
        while disk and disk[-1].isdigit():
            disk = disk[:-1]
        if disk.endswith("p"):
            disk = disk[:-1]
        base = f"/sys/block/{disk}"
        model = open(f"{base}/device/model", encoding="utf-8").read().strip()
        sectors = int(open(f"{base}/size", encoding="utf-8").read().strip())
        return f"{model} · {sectors * 512 / 1024 ** 3:.1f} GiB"
    except (OSError, ValueError):
        return os.path.basename(dev)


def key_present() -> bool:
    try:
        out = subprocess.run(["fido2-token", "-L"], capture_output=True,
                             text=True, timeout=5)
        return bool(out.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        return False


class Volume:
    __slots__ = ("uuid", "dev", "state", "mount")

    def __init__(self, uuid: str, dev: str, state: str, mount: str):
        self.uuid, self.dev, self.state, self.mount = uuid, dev, state, mount

    @property
    def title(self) -> str:
        return volume_title(self.dev)


class Window(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application):
        super().__init__(application=app, title="Pendrive Vault")
        self.busy = False
        self.volumes: list[Volume] = []
        self.log_lines: list[str] = []
        self._pending = ""
        self._cands: list[str] = []
        self._last_list = 0.0
        self._listing = False
        self._selecting = False
        self.set_default_size(470, -1)
        self.set_resizable(False)

        header = Gtk.HeaderBar()
        self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for edge in ("top", "bottom", "start", "end"):
            getattr(root, f"set_margin_{edge}")(18)
        self.set_child(root)

        # --- state card -------------------------------------------------
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("card")
        for edge in ("top", "bottom", "start", "end"):
            getattr(card, f"set_margin_{edge}")(14)

        self.state_label = Gtk.Label(label="Checking…", xalign=0)
        self.state_label.add_css_class("title-3")
        self.detail_label = Gtk.Label(label="", xalign=0)
        self.detail_label.add_css_class("dim-label")
        self.detail_label.set_wrap(True)

        self.selector = Gtk.DropDown(model=Gtk.StringList.new([]))
        self.selector.set_visible(False)
        self.selector.connect("notify::selected", self.on_select)

        card.append(self.state_label)
        card.append(self.detail_label)
        card.append(self.selector)
        root.append(card)

        # --- action banner (the "touch your key" cue) -------------------
        self.banner = Gtk.Label(xalign=0)
        self.banner.add_css_class("title-1")
        self.banner.set_wrap(True)
        self.banner.set_visible(False)
        root.append(self.banner)

        # --- progress ---------------------------------------------------
        self.spinner = Gtk.Spinner()
        self.hint_label = Gtk.Label(label="", xalign=0)
        self.hint_label.add_css_class("dim-label")
        self.hint_label.set_wrap(True)
        hint_row = Gtk.Box(spacing=10)
        hint_row.append(self.spinner)
        hint_row.append(self.hint_label)
        root.append(hint_row)

        # --- buttons ----------------------------------------------------
        self.fido_btn = Gtk.Button(label="Unlock with FIDO2 key")
        self.fido_btn.add_css_class("suggested-action")
        self.fido_btn.add_css_class("pill")
        self.fido_btn.set_size_request(-1, 44)
        self.fido_btn.connect("clicked", self.on_fido)

        self.pass_btn = Gtk.Button(label="Unlock with passphrase")
        self.pass_btn.add_css_class("pill")
        self.pass_btn.set_size_request(-1, 44)
        self.pass_btn.connect("clicked", self.on_pass)

        self.open_btn = Gtk.Button(label="Open folder")
        self.open_btn.set_size_request(-1, 38)
        self.open_btn.connect("clicked", lambda *_: self.open_folder())

        self.lock_btn = Gtk.Button(label="Lock")
        self.lock_btn.set_size_request(-1, 38)
        self.lock_btn.add_css_class("destructive-action")
        self.lock_btn.connect("clicked", self.on_lock)

        root.append(self.fido_btn)
        root.append(self.pass_btn)

        row = Gtk.Box(spacing=8)
        row.append(self.open_btn)
        row.append(self.lock_btn)
        root.append(row)

        # --- live output -------------------------------------------------
        self.details = Gtk.Expander(label="Details")
        self.details.set_expanded(False)
        self.textview = Gtk.TextView(editable=False, cursor_visible=False,
                                     monospace=True,
                                     wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroller = Gtk.ScrolledWindow()
        scroller.set_child(self.textview)
        scroller.set_min_content_height(110)
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.details.set_child(scroller)
        root.append(self.details)

        self.refresh_volumes(force=True)
        GLib.timeout_add(1500, self._tick)

    # ------------------------------------------------------------------
    def selected(self) -> Volume | None:
        idx = self.selector.get_selected()
        if 0 <= idx < len(self.volumes):
            return self.volumes[idx]
        return self.volumes[0] if len(self.volumes) == 1 else None

    def _tick(self):
        if not self.busy:
            cands = usb_luks_devices()
            stale = (time.monotonic() - self._last_list) > 10
            if cands != self._cands or stale:
                self.refresh_volumes()
            else:
                self.render()
        return True

    # ------------------------------------------------------------------
    def refresh_volumes(self, force: bool = False):
        if not force and self._listing:
            return
        self._listing = True
        self._cands = usb_luks_devices()
        self._last_list = time.monotonic()

        def work():
            try:
                res = subprocess.run(["pkexec", HELPER, "list"],
                                     capture_output=True, text=True, timeout=30)
                rows = []
                for line in res.stdout.splitlines():
                    parts = line.split("\t")
                    if len(parts) >= 3:
                        rows.append(Volume(parts[0], parts[1], parts[2],
                                           parts[3] if len(parts) > 3 else ""))
                err = res.stdout if res.returncode else ""
            except (OSError, subprocess.SubprocessError) as exc:
                rows, err = [], str(exc)
            GLib.idle_add(self._volumes_loaded, rows, err)

        threading.Thread(target=work, daemon=True).start()

    def _volumes_loaded(self, rows: list[Volume], err: str):
        self._listing = False
        titles = [v.title for v in rows]
        if len(titles) != len(set(titles)):  # identical sticks
            titles = [f"{v.title} · {v.uuid[:8]}" for v in rows]

        keep = self.selected().uuid if self.volumes and self.selected() else None
        self.volumes = rows
        self._selecting = True
        self.selector.set_model(Gtk.StringList.new(titles))
        idx = 0
        if keep:
            for i, vol in enumerate(rows):
                if vol.uuid == keep:
                    idx = i
        self.selector.set_selected(idx)
        self._selecting = False
        self.selector.set_visible(len(rows) > 1)
        self.render()
        return False

    def on_select(self, *_):
        if not self._selecting:
            self.render()

    # ------------------------------------------------------------------
    def render(self):
        vol = self.selected()
        if vol is None:
            self.state_label.set_text("No vault volume detected")
            self.detail_label.set_text(
                "Plug in a LUKS2 volume labelled PENDRIVE_VAULT.\n"
                "This window updates by itself.")
            for btn in (self.fido_btn, self.pass_btn, self.open_btn, self.lock_btn):
                btn.set_sensitive(False)
            return

        if vol.state == "mounted":
            self.state_label.set_text("Unlocked and mounted")
            self.detail_label.set_text(f"{vol.title}\n{vol.mount}")
        elif vol.state == "unlocked":
            self.state_label.set_text("Unlocked (not mounted)")
            self.detail_label.set_text(f"{vol.title}\nOpen the folder, or lock it again.")
        else:
            self.state_label.set_text("Locked")
            key = "security key detected" if key_present() else "security key not detected"
            self.detail_label.set_text(f"{vol.title} · {key}")

        can_unlock = vol.state == "locked" and not self.busy
        self.fido_btn.set_sensitive(can_unlock)
        self.pass_btn.set_sensitive(can_unlock)
        self.open_btn.set_sensitive(vol.state == "mounted")
        self.lock_btn.set_sensitive(vol.state != "locked" and not self.busy)

    # ------------------------------------------------------------------
    def _set_details(self, text: str):
        buf = self.textview.get_buffer()
        buf.set_text(text)
        self.textview.scroll_to_iter(buf.get_end_iter(), 0.0, False, 0.0, 1.0)

    def _chunk(self, text: str):
        if not text:
            return False
        text = text.replace("\r", "")
        self._pending += text
        *lines, rest = self._pending.split("\n")
        self._pending = rest
        for line in lines:
            if line.strip():
                self.log_lines.append(line)
        del self.log_lines[:-200]
        shown = list(self.log_lines)
        if rest.strip():
            shown.append(rest)
        self._set_details("\n".join(shown[-200:]))
        if TOUCH_RE.search(text):
            self.banner.set_text("👉  TOUCH YOUR SECURITY KEY NOW")
            self.banner.set_visible(True)
        elif "STEP:waiting-for-token" in text:
            self.hint_label.set_text("Touch the security key when it blinks…")
        return False

    def error(self, text: str):
        dlg = Gtk.AlertDialog()
        dlg.set_modal(True)
        dlg.set_message("Pendrive Vault")
        dlg.set_detail(text)
        dlg.set_buttons(["OK"])
        dlg.set_cancel_button(0)
        dlg.set_default_button(0)
        dlg.show(self)

    def open_folder(self):
        vol = self.selected()
        target = vol.mount if vol and vol.mount else f"/run/media/{USER}"
        try:
            subprocess.Popen(["xdg-open", target],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError as exc:
            self.error(f"Could not open the file manager:\n{exc}")

    # ------------------------------------------------------------------
    def ask(self, title: str, label: str, callback):
        win = Gtk.Window(transient_for=self, modal=True, title=title)
        win.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for edge in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{edge}")(18)
        win.set_child(box)

        lbl = Gtk.Label(label=label, xalign=0)
        lbl.set_wrap(True)
        lbl.set_max_width_chars(46)
        box.append(lbl)

        entry = Gtk.PasswordEntry(show_peek_icon=True)
        box.append(entry)

        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        ok = Gtk.Button(label="Unlock")
        ok.add_css_class("suggested-action")
        buttons.append(cancel)
        buttons.append(ok)
        box.append(buttons)

        def submit(*_):
            value = entry.get_text()
            win.destroy()
            callback(value)

        ok.connect("clicked", submit)
        entry.connect("activate", submit)
        cancel.connect("clicked", lambda *_: win.destroy())
        win.present()
        entry.grab_focus()

    # ------------------------------------------------------------------
    def on_fido(self, *_):
        vol = self.selected()
        if not vol:
            return
        if key_present():
            self._ask_pin(vol)
        else:
            self._await_key(lambda: self._ask_pin(vol))

    def _ask_pin(self, vol: Volume):
        def go(pin: str):
            self._run("unlock-fido2", vol.uuid, pin + "\n",
                      "Verifying PIN with the key…")

        self.ask("FIDO2 key",
                 "Enter the FIDO2 PIN for your security key.\n"
                 "Once accepted, the key blinks — touch it within about 30 seconds.", go)

    def _await_key(self, then):
        """Ask for the security key *before* the PIN, and wait until it appears."""
        win = Gtk.Window(transient_for=self, modal=True, title="Security key needed")
        win.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for edge in ("top", "bottom", "start", "end"):
            getattr(box, f"set_margin_{edge}")(18)
        win.set_child(box)

        title = Gtk.Label(label="Plug in your security key", xalign=0)
        title.add_css_class("title-3")
        sub = Gtk.Label(label="Waiting for a FIDO2 key to appear…", xalign=0)
        sub.add_css_class("dim-label")
        sub.set_wrap(True)
        row = Gtk.Box(spacing=10)
        spinner = Gtk.Spinner()
        spinner.start()
        row.append(spinner)
        cancel = Gtk.Button(label="Cancel", halign=Gtk.Align.END)
        box.append(title)
        box.append(sub)
        box.append(row)
        box.append(cancel)

        state = {"alive": True}

        def stop():
            state["alive"] = False
            win.destroy()

        def poll():
            if not state["alive"]:
                return False
            if key_present():
                state["alive"] = False
                spinner.stop()
                win.destroy()
                then()
                return False
            return True

        cancel.connect("clicked", lambda *_: stop())
        win.connect("close-request", lambda *_: (stop(), False)[1])
        win.present()
        GLib.timeout_add(400, poll)

    def on_pass(self, *_):
        vol = self.selected()
        if not vol:
            return

        def go(passphrase: str):
            self._run("unlock-passphrase", vol.uuid, passphrase + "\n",
                      "Checking passphrase…")

        self.ask("Passphrase", "Enter the passphrase for the encrypted volume.", go)

    def on_lock(self, *_):
        vol = self.selected()
        if vol:
            self._run("lock", vol.uuid, "", "Locking…")

    # ------------------------------------------------------------------
    def _run(self, action: str, uuid: str, secret: str, hint: str):
        if self.busy:
            return
        self.busy = True
        self.log_lines = []
        self._pending = ""
        self._set_details("")
        self.banner.set_visible(False)
        self.spinner.start()
        self.hint_label.set_text(hint)
        self.render()

        def work():
            code = 97
            try:
                proc = subprocess.Popen(
                    ["pkexec", HELPER, action, uuid],
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT)
                try:
                    proc.stdin.write(secret.encode())
                    proc.stdin.close()
                except (BrokenPipeError, OSError):
                    pass
                while True:
                    chunk = os.read(proc.stdout.fileno(), 4096)
                    if not chunk:
                        break
                    GLib.idle_add(self._chunk, chunk.decode(errors="replace"))
                code = proc.wait()
            except Exception as exc:  # noqa: BLE001
                GLib.idle_add(self._chunk, f"\nerror: {exc}\n")
            GLib.idle_add(self._finished, action, code)

        threading.Thread(target=work, daemon=True).start()

    def _finished(self, action: str, code: int):
        self.busy = False
        self.spinner.stop()
        self.banner.set_visible(False)
        self.hint_label.set_text("")
        self.refresh_volumes(force=True)

        if code == 0:
            self.hint_label.set_text("Unlocked — opening folder…"
                                     if action.startswith("unlock") else "Locked.")
            if action.startswith("unlock"):
                vol = self.selected()
                if vol and vol.state == "mounted":
                    self.open_folder()
            return False

        msg = None
        for line in self.log_lines:
            if line.startswith("ERR:"):
                token = line[4:].split()[0] if line[4:].split() else ""
                msg = ERRORS.get(token)
        if msg is None:
            if code == 126:
                msg = "Authorisation cancelled."
            elif code == 127:
                msg = "Not authorised to run the helper."
            else:
                tail = [ln for ln in self.log_lines if ln.strip()][-6:]
                msg = "Operation failed.\n\n" + ("\n".join(tail) or f"exit code {code}")
        self.details.set_expanded(True)
        self.error(msg)
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    App().run(None)

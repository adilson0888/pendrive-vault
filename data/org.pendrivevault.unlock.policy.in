<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pendrive Vault</vendor>
  <action id="org.pendrivevault.unlock">
    <description>Unlock and mount the encrypted pendrive</description>
    <message>Authentication is required to unlock the encrypted pendrive</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/pendrive-vault-helper</annotate>
  </action>
</policyconfig>
